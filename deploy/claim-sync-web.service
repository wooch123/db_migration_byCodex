[Unit]
Description=Claim Sync web operations console
Wants=network-online.target claim-sync-worker.service
After=network-online.target

[Service]
Type=simple
User=claimsync
Group=claimsync
WorkingDirectory=/opt/claim-sync
Environment=PYTHONUNBUFFERED=1
Environment=DATA_DIR=/var/lib/claim-sync
Environment=ENABLE_RUNNER=false
ExecStart=/opt/claim-sync/.venv/bin/claim-sync --env-file /etc/claim-sync/claim-sync.env web --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
StateDirectory=claim-sync
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/claim-sync
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
