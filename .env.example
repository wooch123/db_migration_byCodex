# Connect to the supplied intranet APIs. Requires access to the corporate network.
APP_MODE=live
DATA_DIR=./data
TIMEZONE=Asia/Seoul
ENABLE_RUNNER=true
HOST=127.0.0.1
PORT=8000
# Required when binding the web server to a non-loopback address.
APP_ACCESS_TOKEN=
ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]

# Supplied intranet URLs are also the code defaults; override here without code changes.
# Set APP_MODE=mock explicitly only for isolated development/testing.
CLAIMS_BASE_URL=http://12.81.220.37:8080
CLAIMS_PATH=/api/searchFlashClaims
# Claim start/end date query parameter names; override for a different API contract.
CLAIMS_FROM_PARAM=rcvDateFrom
CLAIMS_TO_PARAM=rcvDateTo
CLAIMS_LIMIT=1000
CLAIMS_RECORDS_PATH=auto
CLAIMS_HEADERS={}
PRODUCT_BASE_URL=http://12.81.221.145:5273
PRODUCT_SCHEMA_PATH=/dbms/api/product-info/schema
PRODUCT_RECORD_PATH=/dbms/api/product-info/record/{part_id}
PRODUCT_RECORDS_PATH=auto
PRODUCT_HEADERS={}
TARGET_BASE_URL=https://estgtask.samsungds.net
# POST creation and duplicate-key PATCH updates use the same URL, headers and TLS settings.
TARGET_PATH=/api/external/far_table
TARGET_HEADERS={}

# Real POST/PATCH writes require APP_MODE=live and both switches after contract verification.
ALLOW_LIVE_WRITES=false
# Confirms the POST + duplicate-key PATCH contract; POST need not perform upsert itself.
TARGET_UPSERT_CONFIRMED=false
# Local delivery-ledger key. PATCH always matches far_no AND sample_no.
TARGET_KEY_FIELDS=["far_no","sample_no"]
# Change when the target database is reset or the tenant/dataset changes.
TARGET_DATASET_ID=default
# POST and PATCH use distinct operation keys; neither is retried after uncertain delivery.
TARGET_IDEMPOTENCY_HEADER=Idempotency-Key
# Optional application-level acknowledgement, e.g. success / true.
# JSON value, not a Python literal. An empty path accepts a non-error 2xx response except 202.
TARGET_SUCCESS_PATH=
TARGET_SUCCESS_VALUE=true

HTTP_TIMEOUT_SECONDS=30
GET_RETRIES=3
RETRY_BACKOFF_SECONDS=1
TLS_VERIFY=true
# PEM certificate bundle for a corporate CA; never disable TLS for normal operation.
# Windows PFX/P12: run export-ca.bat, then set CA_BUNDLE=certs/corporate-ca.pem.
CA_BUNDLE=
TRUST_ENV_PROXY=false
MAX_RESPONSE_BYTES=10485760
# Maximum decoded request/response body bytes stored per HTTP exchange (1 KiB to 10 MiB).
HTTP_LOG_BODY_BYTES=262144
